<Window x:Class="Clayboard.UI.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clayboard" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <StackPanel x:Name="Body" Margin="24,20,24,20">
            <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="Medium" Background="Transparent"
                       MouseLeftButtonDown="OnDragHeader"/>
            <TextBox x:Name="Input" Style="{StaticResource Field}" Margin="0,14,0,0" TextChanged="OnTextChanged"/>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource TerraBrush}" TextWrapping="Wrap"
                       Margin="2,8,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Ed.Cancel}" Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Ed.Save}" IsDefault="True"
                        Click="OnSave"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
