<Window x:Class="MacroInWZa007.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macro" Width="780" Height="540" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="{DynamicResource Win.Minimize}"
                                Click="OnMinimize"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;"
                                ToolTip="{DynamicResource Win.Maximize}" Click="OnMaximize"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="{DynamicResource Win.CloseToTray}"
                                Click="OnClose"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource ClayBrush}"/>
                        <TextBlock Text="Macro" FontWeight="Medium" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="10,16">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Margin="12,0,12,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource SageBrush}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusText}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource LinkButton}" Content="{Binding PauseLabel}"
                                    HorizontalAlignment="Right" Click="OnTogglePause"/>
                        </Grid>
                        <StackPanel>
                            <RadioButton x:Name="NavBindings" Style="{StaticResource NavItem}" IsChecked="True"
                                         Tag="Bindings"
                                         Checked="OnNavChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE765;"/>
                                    <TextBlock Text="{DynamicResource Nav.Bindings}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" Tag="Profiles" Checked="OnNavChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE81E;"/>
                                    <TextBlock Text="{DynamicResource Nav.Profiles}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" Tag="Macros" Checked="OnNavChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7C8;"/>
                                    <TextBlock Text="{DynamicResource Nav.Macros}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" Tag="Settings" Checked="OnNavChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/>
                                    <TextBlock Text="{DynamicResource Nav.Settings}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Bindings page -->
                <Grid x:Name="BindingsPage" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="24,22,24,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource GhostButton}" Click="OnReload" Margin="0,0,8,0"
                                    Padding="11,8" ToolTip="{DynamicResource List.Reload}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="OnEditConfig" Margin="0,0,8,0"
                                    Padding="11,8" ToolTip="{DynamicResource List.EditConfig}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Click="OnNew">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11"/>
                                    <TextBlock Text="{DynamicResource List.New}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}"/>
                                <Button Style="{StaticResource LinkButton}" Content="{DynamicResource List.ShowAll}" Margin="10,0,0,0"
                                        Click="OnShowAll"
                                        Visibility="{Binding IsProfileScope, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="{StaticResource TerraSoftBrush}" CornerRadius="8"
                            Padding="12,9" Margin="24,0,24,12"
                            Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource TerraBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBox Grid.Row="2" Style="{StaticResource SearchBox}" Tag="{DynamicResource List.Search}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="24,0,24,12"/>

                    <Grid Grid.Row="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
                            </ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding View}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}" MouseLeftButtonUp="OnRowClick"
                                                ToolTip="{DynamicResource List.ClickToEdit}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="44"/>
                                                </Grid.ColumnDefinitions>
                                                <ItemsControl x:Name="Keys" ItemsSource="{Binding KeyCaps}"
                                                              VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Border x:Name="Cap" Style="{StaticResource KeyCap}">
                                                                    <TextBlock Text="{Binding Text}" FontSize="12"
                                                                               FontFamily="{StaticResource MonoFont}"/>
                                                                </Border>
                                                                <TextBlock x:Name="Word" Style="{StaticResource Muted}"
                                                                           Text="{Binding Text}" Margin="2,0,6,0"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="Collapsed"/>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsKey}" Value="False">
                                                                    <Setter TargetName="Cap" Property="Visibility"
                                                                            Value="Collapsed"/>
                                                                    <Setter TargetName="Word" Property="Visibility"
                                                                            Value="Visible"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel x:Name="Info" Grid.Column="1" VerticalAlignment="Center"
                                                            Margin="12,0">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Subtitle}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Error}" FontSize="12"
                                                               Foreground="{StaticResource TerraBrush}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <ToggleButton Grid.Column="2" Style="{StaticResource Switch}"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                                              ToolTip="{DynamicResource List.Toggle}"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="Keys" Property="Opacity" Value="0.5"/>
                                                <Setter TargetName="Info" Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding EmptyText}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,40,0,0"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>

                <!-- Profiles page -->
                <DockPanel x:Name="ProfilesPage" Grid.Column="1" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="24,22,24,14">
                        <TextBlock Text="{DynamicResource Profiles.Title}" FontSize="22" FontWeight="Medium"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   Text="{DynamicResource Profiles.Description}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
                        </ScrollViewer.Resources>
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" MouseLeftButtonUp="OnProfileClick"
                                            ToolTip="{DynamicResource Profiles.Open}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}"
                                                       Text="&#xE76C;" FontSize="11"
                                                       Foreground="{StaticResource MuteBrush}"/>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}"
                                                       Text="{Binding CountText}" VerticalAlignment="Center"
                                                       Margin="0,0,14,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Hint}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Settings page -->
                <StackPanel x:Name="SettingsPage" Grid.Column="1" Visibility="Collapsed" Margin="24,22,24,14">
                    <TextBlock Text="{DynamicResource Settings.Title}" FontSize="22" FontWeight="Medium"/>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16,14,16,8" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.Language}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Settings.LanguageHint}"/>
                            <WrapPanel x:Name="LanguageChips" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                        <DockPanel>
                            <ToggleButton x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          VerticalAlignment="Center" Checked="OnStartupToggled"
                                          Unchecked="OnStartupToggled"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings.Startup}"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="{DynamicResource Settings.StartupHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Settings.OpenFolder}"
                                    Padding="12,7" VerticalAlignment="Center" Click="OnOpenConfigFolder"/>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Settings.ConfigFile}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding ConfigPath}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="SettingsError" Foreground="{StaticResource TerraBrush}" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
