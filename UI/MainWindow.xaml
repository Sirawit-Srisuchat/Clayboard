<Window x:Class="Clayboard.UI.MainWindow"
        xmlns:local="clr-namespace:Clayboard.UI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clayboard" Width="780" Height="540" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="{DynamicResource Win.Minimize}"
                                Click="OnMinimize"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;"
                                ToolTip="{DynamicResource Win.Maximize}" Click="OnMaximize"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="{DynamicResource Win.CloseToTray}"
                                Click="OnClose"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource ClayBrush}"/>
                        <TextBlock Text="Clayboard" FontWeight="Medium" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="10,16">
                    <DockPanel>
                        <Grid DockPanel.Dock="Bottom" Margin="12,0,12,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource SageBrush}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding StatusText}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource LinkButton}" Content="{Binding PauseLabel}"
                                    HorizontalAlignment="Right" Click="OnTogglePause"/>
                        </Grid>
                        <StackPanel>
                            <RadioButton x:Name="NavBindings" Style="{StaticResource NavItem}" IsChecked="True"
                                         Tag="Bindings"
                                         Checked="OnNavChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE765;"/>
                                    <TextBlock Text="{DynamicResource Nav.Bindings}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" Tag="Profiles" Checked="OnNavChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE81E;"/>
                                    <TextBlock Text="{DynamicResource Nav.Profiles}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" Tag="Macros" Checked="OnNavChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7C8;"/>
                                    <TextBlock Text="{DynamicResource Nav.Macros}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" Tag="Settings" Checked="OnNavChecked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/>
                                    <TextBlock Text="{DynamicResource Nav.Settings}" Margin="10,0,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Bindings page -->
                <Grid x:Name="BindingsPage" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="24,22,24,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource GhostButton}" Click="OnReload" Margin="0,0,8,0"
                                    Padding="11,8" ToolTip="{DynamicResource List.Reload}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="OnEditConfig" Margin="0,0,8,0"
                                    Padding="11,8" ToolTip="{DynamicResource List.EditConfig}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE943;" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Click="OnNew">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11"/>
                                    <TextBlock Text="{DynamicResource List.New}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Summary}"/>
                                <Button Style="{StaticResource LinkButton}" Content="{DynamicResource List.ShowAll}" Margin="10,0,0,0"
                                        Click="OnShowAll"
                                        Visibility="{Binding IsProfileScope, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1">
                        <Border Background="{StaticResource TerraSoftBrush}" CornerRadius="8"
                                Padding="12,9" Margin="24,0,24,12"
                                Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource TerraBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Border Background="{StaticResource TerraSoftBrush}" CornerRadius="8"
                                Padding="12,9" Margin="24,0,24,12"
                                Visibility="{Binding HasUntrusted, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="12,6"
                                        Margin="12,0,0,0" VerticalAlignment="Center" Content="{DynamicResource Trust.Allow}"
                                        Click="OnAllowUntrusted"/>
                                <TextBlock Text="{Binding TrustBanner}" Foreground="{StaticResource TerraBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="24,0,24,8">
                        <TextBox Style="{StaticResource SearchBox}" Tag="{DynamicResource List.Search}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <DockPanel Margin="2,10,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="OnNewGroup">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="10"/>
                                    <TextBlock Text="{DynamicResource Group.New}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource LinkButton}" Click="OnSortMenu">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SortLabel}"/>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Margin="5,1,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource LinkButton}" Click="OnShowMenu" Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ShowLabel}"/>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="8" Margin="5,1,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource List.ReorderHint}"
                                           Margin="18,0,0,0" Opacity="0.8" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ShowReorderHint, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
                            </ScrollViewer.Resources>
                            <ItemsControl x:Name="BindingList" ItemsSource="{Binding Rows}" Background="Transparent"
                                          MouseMove="OnListMouseMove" PreviewMouseLeftButtonUp="OnListMouseUp"
                                          LostMouseCapture="OnListLostCapture">
                                <ItemsControl.Resources>
                                    <!-- A group's title row: click to fold, drag the handle to reorder groups -->
                                    <DataTemplate DataType="{x:Type local:GroupHeader}">
                                        <Border x:Name="HeaderRow" Background="Transparent" Padding="8,16,24,6"
                                                Cursor="Hand" MouseLeftButtonUp="OnHeaderClick" Loaded="OnRowLoaded">
                                            <DockPanel>
                                                <Button x:Name="HeaderMenu" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                        Content="&#xE712;" Opacity="0" Click="OnGroupMenu"
                                                        ToolTip="{DynamicResource Group.Menu}"/>
                                                <TextBlock x:Name="Handle" Style="{StaticResource Icon}" Text="&#xE700;"
                                                           FontSize="11" Width="18" Foreground="{StaticResource MuteBrush}"
                                                           Background="Transparent" Cursor="SizeAll"
                                                           ToolTip="{DynamicResource Row.Drag}"
                                                           PreviewMouseLeftButtonDown="OnHandleDown"
                                                           PreviewMouseMove="OnHandleMove" MouseLeftButtonUp="OnHandleUp"/>
                                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Chevron}" FontSize="9"
                                                           Foreground="{StaticResource MuteBrush}" Margin="2,0,8,0"/>
                                                <TextBlock Text="{Binding Display}" FontWeight="Medium" FontSize="12"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Count}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="HeaderRow" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderMenu" Property="Opacity" Value="1"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsNamed}" Value="False">
                                                <Setter TargetName="Handle" Property="Visibility" Value="Hidden"/>
                                                <Setter TargetName="HeaderMenu" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         Value="False">
                                                <Setter TargetName="Handle" Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>

                                    <!-- A binding: click to edit, drag the handle or use the arrows to move it -->
                                    <DataTemplate DataType="{x:Type local:BindingItem}">
                                        <Border x:Name="RowBorder" Style="{StaticResource Row}" Padding="8,12,24,12"
                                                MouseLeftButtonUp="OnRowClick" Loaded="OnRowLoaded"
                                                ToolTip="{DynamicResource List.ClickToEdit}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="44"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Handle" Style="{StaticResource Icon}" Text="&#xE700;"
                                                           FontSize="11" Foreground="{StaticResource MuteBrush}"
                                                           Background="Transparent" Cursor="SizeAll" Opacity="0.45"
                                                           ToolTip="{DynamicResource Row.Drag}"
                                                           PreviewMouseLeftButtonDown="OnHandleDown"
                                                           PreviewMouseMove="OnHandleMove" MouseLeftButtonUp="OnHandleUp"/>
                                                <ItemsControl x:Name="Keys" Grid.Column="1" ItemsSource="{Binding KeyCaps}"
                                                              VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Border x:Name="Cap" Style="{StaticResource KeyCap}">
                                                                    <TextBlock Text="{Binding Text}" FontSize="12"
                                                                               FontFamily="{StaticResource MonoFont}"/>
                                                                </Border>
                                                                <TextBlock x:Name="Word" Style="{StaticResource Muted}"
                                                                           Text="{Binding Text}" Margin="2,0,6,0"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="Collapsed"/>
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsKey}" Value="False">
                                                                    <Setter TargetName="Cap" Property="Visibility"
                                                                            Value="Collapsed"/>
                                                                    <Setter TargetName="Word" Property="Visibility"
                                                                            Value="Visible"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel x:Name="Info" Grid.Column="2" VerticalAlignment="Center"
                                                            Margin="12,0">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Subtitle}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Error}" FontSize="12"
                                                               Foreground="{StaticResource TerraBrush}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <StackPanel x:Name="MoveButtons" Grid.Column="3" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0">
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;"
                                                            ToolTip="{DynamicResource Ed.MoveUp}" Click="OnMoveUp"/>
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;"
                                                            ToolTip="{DynamicResource Ed.MoveDown}" Click="OnMoveDown"/>
                                                </StackPanel>
                                                <ToggleButton Grid.Column="4" Style="{StaticResource Switch}"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                                              ToolTip="{DynamicResource List.Toggle}"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="Keys" Property="Opacity" Value="0.5"/>
                                                <Setter TargetName="Info" Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                            <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MoveButtons" Property="Opacity" Value="1"/>
                                                <Setter TargetName="Handle" Property="Opacity" Value="1"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                         Value="False">
                                                <Setter TargetName="Handle" Property="Visibility" Value="Hidden"/>
                                                <Setter TargetName="MoveButtons" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding EmptyText}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,40,0,0"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>

                <!-- Profiles page -->
                <DockPanel x:Name="ProfilesPage" Grid.Column="1" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="24,22,24,14">
                        <TextBlock Text="{DynamicResource Profiles.Title}" FontSize="22" FontWeight="Medium"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   Text="{DynamicResource Profiles.Description}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
                        </ScrollViewer.Resources>
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" MouseLeftButtonUp="OnProfileClick" Loaded="OnRowLoaded"
                                            ToolTip="{DynamicResource Profiles.Open}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}"
                                                       Text="&#xE76C;" FontSize="11"
                                                       Foreground="{StaticResource MuteBrush}"/>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}"
                                                       Text="{Binding CountText}" VerticalAlignment="Center"
                                                       Margin="0,0,14,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Hint}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Settings page -->
                <StackPanel x:Name="SettingsPage" Grid.Column="1" Visibility="Collapsed" Margin="24,22,24,14">
                    <TextBlock Text="{DynamicResource Settings.Title}" FontSize="22" FontWeight="Medium"/>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16,14,16,8" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.Language}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Settings.LanguageHint}"/>
                            <WrapPanel x:Name="LanguageChips" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                        <DockPanel>
                            <ToggleButton x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          VerticalAlignment="Center" Checked="OnStartupToggled"
                                          Unchecked="OnStartupToggled"/>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings.Startup}"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="{DynamicResource Settings.StartupHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Settings.OpenFolder}"
                                    Padding="12,7" VerticalAlignment="Center" Click="OnOpenConfigFolder"/>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Settings.ConfigFile}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding ConfigPath}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Settings.Import}"
                                            Padding="12,7" Margin="0,0,8,0" Click="OnImport"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Settings.Export}"
                                            Padding="12,7" Click="OnExport"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="{DynamicResource Settings.Backup}"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Settings.BackupHint}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- Shown after picking a file to import: add to the current bindings, or replace them -->
                            <DockPanel x:Name="ImportChoice" Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Ed.Cancel}"
                                            Padding="12,6" Margin="0,0,8,0" Click="OnImportCancel"/>
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Settings.ImportReplace}"
                                            Padding="12,6" Margin="0,0,8,0" Click="OnImportReplace"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Settings.ImportAdd}"
                                            Padding="12,6" Click="OnImportAdd"/>
                                </StackPanel>
                                <TextBlock x:Name="ImportFoundText" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                            </DockPanel>
                            <TextBlock x:Name="BackupStatus" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Margin="0,10,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="SequenceWaitBox" Style="{StaticResource Field}" Width="80"
                                         Tag="1500" LostKeyboardFocus="OnSequenceWaitCommitted"
                                         KeyDown="OnSequenceWaitKeyDown"/>
                                <TextBlock Style="{StaticResource Muted}" Text="ms" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Settings.SequenceWait}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Settings.SequenceWaitHint}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.Emergency}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Settings.EmergencyHint}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SettingsError" Foreground="{StaticResource TerraBrush}" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
