<UserControl x:Class="Clayboard.UI.KeyRecorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" IsTabStop="True" FocusVisualStyle="{x:Null}">
    <Grid Cursor="Hand" MouseLeftButtonUp="OnClick" ToolTip="{DynamicResource Rec.Tooltip}" FocusVisualStyle="{x:Null}">
        <Border x:Name="Box" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,14" MinHeight="96">
            <StackPanel x:Name="Panel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl x:Name="Caps" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,5,2" Loaded="OnCapLoaded">
                                <Border x:Name="Cap" Style="{StaticResource KeyCap}" Margin="0">
                                    <TextBlock Text="{Binding Text}" FontSize="13" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                                <TextBlock x:Name="Arrow" Text="{Binding Text}" FontSize="13" Margin="1,0,0,0"
                                           Foreground="{StaticResource MuteBrush}" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsKey}" Value="False">
                                    <Setter TargetName="Cap" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="Status" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <!-- Drains while a sequence waits for more keys; when it's empty the sequence is done -->
        <Border x:Name="Progress" Height="2" VerticalAlignment="Bottom" Margin="16,0,16,7" CornerRadius="1"
                Background="{StaticResource ClayBrush}" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.RenderTransform>
                <ScaleTransform x:Name="ProgressScale"/>
            </Border.RenderTransform>
        </Border>
        <Rectangle x:Name="DashedOutline" RadiusX="10" RadiusY="10" Stroke="{StaticResource ClayBrush}"
                   StrokeThickness="1" StrokeDashArray="4 3" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
