<Window x:Class="Clayboard.UI.BindingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Clayboard.UI"
        Title="Binding" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <DockPanel x:Name="Body">
            <!-- Header doubles as the drag handle -->
            <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="24,20,24,0"
                       MouseLeftButtonDown="OnDragHeader">
                <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Width="30" Height="30"
                        VerticalAlignment="Top" Margin="0,-4,-10,0" Content="&#xE8BB;" ToolTip="{DynamicResource Win.Close}"
                        AutomationProperties.Name="{DynamicResource Win.Close}" Click="OnCancel"/>
                <StackPanel>
                    <TextBlock x:Name="HeaderText" Text="{DynamicResource Ed.New}" FontSize="18" FontWeight="Medium"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                               Text="{DynamicResource Ed.Subtitle}" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- Footer -->
            <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,22">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource TerraBrush}" TextWrapping="Wrap"
                           Margin="0,14,0,0" Visibility="Collapsed"/>
                <!-- Closing with unsaved edits asks first -->
                <Border x:Name="DiscardPanel" Background="{StaticResource TerraSoftBrush}" CornerRadius="8"
                        Padding="12,9" Margin="0,14,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Ed.KeepEditing}"
                                    Padding="12,6" Margin="12,0,8,0" Click="OnKeepEditing"/>
                            <Button x:Name="DiscardButton" Style="{StaticResource PrimaryButton}"
                                    Content="{DynamicResource Ed.Discard}" Padding="12,6" Click="OnDiscard"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Ed.Unsaved}" Foreground="{StaticResource TerraBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <DockPanel Margin="0,18,0,0">
                    <Button x:Name="DeleteButton" Style="{StaticResource LinkButton}" Content="{DynamicResource Ed.Delete}" FontSize="13"
                            Foreground="{StaticResource TerraBrush}" VerticalAlignment="Center" Click="OnDelete"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="TestButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="OnTest" ToolTip="{DynamicResource Ed.TestTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11"/>
                                <TextBlock x:Name="TestLabel" Text="{DynamicResource Ed.Test}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Ed.Cancel}" Margin="0,0,8,0"
                                IsCancel="True" Click="OnCancel"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Ed.Save}" Click="OnSave"
                                IsDefault="True"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel Margin="24,0,24,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Ed.HowToPress}"/>
                    <!-- Segmented control: the white pill slides to the chosen option -->
                    <Border Background="{StaticResource SandBrush}" CornerRadius="10" Padding="3">
                        <Grid>
                            <Border x:Name="ModeThumb" Background="{StaticResource CardBrush}" CornerRadius="8"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ModeThumbShift"/>
                                </Border.RenderTransform>
                            </Border>
                            <UniformGrid x:Name="ModeChips" Rows="1" SizeChanged="OnModeBarSizeChanged">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Tag="press"
                                             Content="{DynamicResource Mode.Press}" IsChecked="True" Checked="OnModeChecked"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Tag="doubleTap"
                                             Content="{DynamicResource Mode.DoubleTap}" Checked="OnModeChecked"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Tag="hold"
                                             Content="{DynamicResource Mode.Hold}" Checked="OnModeChecked"/>
                                <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Tag="sequence"
                                             Content="{DynamicResource Mode.Sequence}" Checked="OnModeChecked"/>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <local:KeyRecorder x:Name="TriggerRecorder" Margin="0,10,0,0" IdleHintKey="Rec.Idle"/>

                    <TextBlock x:Name="ModeHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,8,0,0"
                               Visibility="Collapsed"/>

                    <TextBlock x:Name="KeyWarning" Foreground="{StaticResource TerraBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="2,8,0,0" Visibility="Collapsed"
                               Text="{DynamicResource Ed.Warn.CommonKey}"/>

                    <StackPanel x:Name="HoldPanel" Orientation="Horizontal" Margin="2,10,0,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Ed.HoldFor}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="HoldBox" Style="{StaticResource Field}" AutomationProperties.Name="{DynamicResource Ed.HoldFor}" Tag="500" Width="90" Margin="10,0,0,0"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Ed.Name}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource Field}" AutomationProperties.Name="{DynamicResource Ed.Name}" Tag="{DynamicResource Ed.NamePlaceholder}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Ed.OnlyInApp}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Ed.Choose}"
                                Padding="12,7" Margin="8,0,0,0" Click="OnChooseApp" Tag="{Binding ElementName=AppBox}"/>
                        <TextBox x:Name="AppBox" Style="{StaticResource Field}" AutomationProperties.Name="{DynamicResource Ed.OnlyInApp}" Tag="{DynamicResource Ed.EveryApp}"/>
                    </DockPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Ed.Group}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Ed.Choose}"
                                Padding="12,7" Margin="8,0,0,0" Click="OnChooseGroup"/>
                        <TextBox x:Name="GroupBox" Style="{StaticResource Field}" AutomationProperties.Name="{DynamicResource Ed.Group}" Tag="{DynamicResource Group.None}"/>
                    </DockPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Ed.Action}"/>
                    <WrapPanel x:Name="ActionChips">
                        <RadioButton Style="{StaticResource Chip}" GroupName="ActionType" Tag="run" Content="{DynamicResource Act.Run}"
                                     IsChecked="True" Checked="OnActionTypeChecked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="ActionType" Tag="close" Content="{DynamicResource Act.Close}"
                                     Checked="OnActionTypeChecked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="ActionType" Tag="text" Content="{DynamicResource Act.Text}"
                                     Checked="OnActionTypeChecked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="ActionType" Tag="sendKeys" Content="{DynamicResource Act.Keys}"
                                     Checked="OnActionTypeChecked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="ActionType" Tag="macro" Content="{DynamicResource Act.Macro}"
                                     Checked="OnActionTypeChecked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="ActionType" Tag="media" Content="{DynamicResource Act.Media}"
                                     Checked="OnActionTypeChecked"/>
                    </WrapPanel>

                    <StackPanel x:Name="RunPanel">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Ed.Path}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Ed.Choose}"
                                    Padding="12,7" Margin="8,0,0,0" Click="OnChooseProgram"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Ed.Browse}"
                                    Padding="12,7" Margin="8,0,0,0" Click="OnBrowse"/>
                            <TextBox x:Name="PathBox" Style="{StaticResource Field}" AutomationProperties.Name="{DynamicResource Ed.Path}" Tag="notepad.exe"
                                     TextChanged="OnPathChanged"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Ed.Args}"/>
                        <TextBox x:Name="ArgsBox" Style="{StaticResource Field}" AutomationProperties.Name="{DynamicResource Ed.Args}" Tag="--new-window"/>
                        <DockPanel Margin="0,16,0,0">
                            <ToggleButton x:Name="ToggleCloseSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="{DynamicResource Ed.ToggleClose}"
                                          VerticalAlignment="Center" Checked="OnToggleCloseChanged"
                                          Unchecked="OnToggleCloseChanged"/>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Ed.ToggleClose}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Ed.ToggleCloseHint}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="ToggleTargetPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Ed.CloseWhich}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                        Content="{DynamicResource Ed.Choose}" Padding="12,7" Margin="8,0,0,0"
                                        Click="OnChooseApp" Tag="{Binding ElementName=ToggleProcessBox}"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                        Content="{DynamicResource Ed.Browse}" Padding="12,7" Margin="8,0,0,0"
                                        Click="OnBrowseApp" Tag="{Binding ElementName=ToggleProcessBox}"/>
                                <TextBox x:Name="ToggleProcessBox" Style="{StaticResource Field}" AutomationProperties.Name="{DynamicResource Ed.CloseWhich}" Tag="notepad.exe"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ClosePanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Ed.AppToClose}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                    Content="{DynamicResource Ed.Choose}" Padding="12,7" Margin="8,0,0,0"
                                    Click="OnChooseApp" Tag="{Binding ElementName=CloseProcessBox}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                    Content="{DynamicResource Ed.Browse}" Padding="12,7" Margin="8,0,0,0"
                                    Click="OnBrowseApp" Tag="{Binding ElementName=CloseProcessBox}"/>
                            <TextBox x:Name="CloseProcessBox" Style="{StaticResource Field}" AutomationProperties.Name="{DynamicResource Ed.AppToClose}" Tag="notepad.exe"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Ed.CloseHint}" TextWrapping="Wrap"
                                   Margin="2,8,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="TextPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Ed.TextToType}"/>
                        <TextBox x:Name="ValueBox" Style="{StaticResource Field}" AutomationProperties.Name="{DynamicResource Ed.TextToType}" Tag="you@example.com"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto"/>
                        <DockPanel Margin="0,12,0,0">
                            <ToggleButton x:Name="SecretSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="{DynamicResource Ed.Secret}"
                                          VerticalAlignment="Center"/>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Ed.Secret}"/>
                                <TextBlock Style="{StaticResource Muted}" Text="{DynamicResource Ed.SecretHint}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel x:Name="KeysPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Ed.KeysToSend}"/>
                        <local:KeyRecorder x:Name="KeysRecorder" IdleHintKey="Rec.IdleSend"/>
                    </StackPanel>

                    <StackPanel x:Name="MacroPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Ed.Steps}"/>
                        <ItemsControl x:Name="StepList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6" Loaded="OnStepLoaded">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Number}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="2">
                                            <local:KeyRecorder x:Name="StepKeys" Compact="True" Keys="{Binding Keys}"
                                                               IdleHintKey="Rec.IdleShort" Visibility="Collapsed"/>
                                            <TextBox x:Name="StepText" Style="{StaticResource Field}" Tag="{DynamicResource Ed.TextToType}"
                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"
                                                     Visibility="Collapsed"/>
                                            <DockPanel x:Name="StepDelay" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="ms"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <TextBox Style="{StaticResource Field}" Tag="100"
                                                         Text="{Binding Ms, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DockPanel>
                                            <TextBox x:Name="StepPath" Style="{StaticResource Field}" Tag="notepad.exe"
                                                     Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="Collapsed"/>
                                            <TextBlock x:Name="StepMedia" Text="{Binding CommandLabel}"
                                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </Grid>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;"
                                                    ToolTip="{DynamicResource Ed.MoveUp}" Click="OnMoveStepUp"
                                                    AutomationProperties.Name="{DynamicResource Ed.MoveUp}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;"
                                                    ToolTip="{DynamicResource Ed.MoveDown}" Click="OnMoveStepDown"
                                                    AutomationProperties.Name="{DynamicResource Ed.MoveDown}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                                                    ToolTip="{DynamicResource Ed.Remove}" Click="OnRemoveStep"
                                                    AutomationProperties.Name="{DynamicResource Ed.Remove}"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="sendKeys">
                                            <Setter TargetName="StepKeys" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="text">
                                            <Setter TargetName="StepText" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="delay">
                                            <Setter TargetName="StepDelay" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="run">
                                            <Setter TargetName="StepPath" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="close">
                                            <Setter TargetName="StepPath" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="media">
                                            <Setter TargetName="StepMedia" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AddStepButton" Style="{StaticResource LinkButton}" Content="{DynamicResource Ed.AddStep}"
                                HorizontalAlignment="Left" Click="OnAddStep">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Menu.Keys}" Tag="sendKeys" Click="OnAddStepOfType"/>
                                    <MenuItem Header="{DynamicResource Menu.TypeText}" Tag="text" Click="OnAddStepOfType"/>
                                    <MenuItem Header="{DynamicResource Menu.Wait}" Tag="delay" Click="OnAddStepOfType"/>
                                    <MenuItem Header="{DynamicResource Menu.Run}" Tag="run" Click="OnAddStepOfType"/>
                                    <MenuItem Header="{DynamicResource Menu.Close}" Tag="close" Click="OnAddStepOfType"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="MediaPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Ed.Command}"/>
                        <WrapPanel x:Name="MediaChips">
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="playPause"
                                         Content="{DynamicResource Media.playPause}" IsChecked="True"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="next" Content="{DynamicResource Media.next}"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="previous" Content="{DynamicResource Media.previous}"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="stop" Content="{DynamicResource Media.stop}"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="volumeUp" Content="{DynamicResource Media.volumeUp}"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="volumeDown"
                                         Content="{DynamicResource Media.volumeDown}"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="mute" Content="{DynamicResource Media.mute}"/>
                        </WrapPanel>
                    </StackPanel>

                    <DockPanel Margin="0,18,0,0">
                        <ToggleButton x:Name="SuppressSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="{DynamicResource Ed.Block}"
                                      VerticalAlignment="Center" IsChecked="True" Checked="OnSuppressChanged"
                                      Unchecked="OnSuppressChanged"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Ed.Block}" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="{DynamicResource Ed.BlockHint}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
