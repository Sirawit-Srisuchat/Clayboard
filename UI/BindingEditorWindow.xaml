<Window x:Class="MacroInWZa007.UI.BindingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MacroInWZa007.UI"
        Title="Binding" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Header doubles as the drag handle -->
            <DockPanel DockPanel.Dock="Top" Background="Transparent" Margin="24,20,24,0"
                       MouseLeftButtonDown="OnDragHeader">
                <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Width="30" Height="30"
                        VerticalAlignment="Top" Margin="0,-4,-10,0" Content="&#xE8BB;" ToolTip="Close"
                        Click="OnCancel"/>
                <StackPanel>
                    <TextBlock x:Name="HeaderText" Text="New binding" FontSize="18" FontWeight="Medium"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                               Text="Click the box, then press the keys you want to use"/>
                </StackPanel>
            </DockPanel>

            <!-- Footer -->
            <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,22">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource TerraBrush}" TextWrapping="Wrap"
                           Margin="0,14,0,0" Visibility="Collapsed"/>
                <DockPanel Margin="0,18,0,0">
                    <Button x:Name="DeleteButton" Style="{StaticResource LinkButton}" Content="Delete" FontSize="13"
                            Foreground="{StaticResource TerraBrush}" VerticalAlignment="Center" Click="OnDelete"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="TestButton" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="OnTest" ToolTip="Run the action now">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="11"/>
                                <TextBlock x:Name="TestLabel" Text="Test" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="Cancel" Margin="0,0,8,0"
                                IsCancel="True" Click="OnCancel"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Save" Click="OnSave"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel Margin="24,0,24,0">
                    <local:KeyRecorder x:Name="TriggerRecorder" Margin="0,16,0,0" IdleHint="Click to record keys"/>

                    <WrapPanel x:Name="ModeChips" Margin="0,10,0,0">
                        <RadioButton Style="{StaticResource Chip}" GroupName="Mode" Tag="press" Content="Press"
                                     IsChecked="True" Checked="OnModeChecked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="Mode" Tag="doubleTap" Content="Double-tap"
                                     Checked="OnModeChecked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="Mode" Tag="hold" Content="Hold"
                                     Checked="OnModeChecked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="Mode" Tag="sequence" Content="Sequence"
                                     Checked="OnModeChecked"/>
                    </WrapPanel>

                    <StackPanel x:Name="SequencePanel" Visibility="Collapsed">
                        <ItemsControl x:Name="SequenceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Muted}" Text="then"
                                                   Width="36" VerticalAlignment="Center"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Content="&#xE711;" ToolTip="Remove" Margin="6,0,0,0"
                                                Click="OnRemoveSequenceStep"/>
                                        <local:KeyRecorder Compact="True" Keys="{Binding Keys}"
                                                           IdleHint="Click to record the next keys"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource LinkButton}" Content="+ Add next keys" HorizontalAlignment="Left"
                                Click="OnAddSequenceStep"/>
                    </StackPanel>

                    <StackPanel x:Name="HoldPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Hold for (ms)" Margin="0,6,0,6"/>
                        <TextBox x:Name="HoldBox" Style="{StaticResource Field}" Tag="500" Width="120"
                                 HorizontalAlignment="Left"/>
                    </StackPanel>

                    <TextBlock x:Name="ModeHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="Collapsed"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource Field}" Tag="Open terminal"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Only in app (optional)"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Choose"
                                Padding="12,7" Margin="8,0,0,0" Click="OnChooseApp"/>
                        <TextBox x:Name="AppBox" Style="{StaticResource Field}" Tag="Every app"/>
                    </DockPanel>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Action"/>
                    <WrapPanel x:Name="ActionChips">
                        <RadioButton Style="{StaticResource Chip}" GroupName="ActionType" Tag="run" Content="Run"
                                     IsChecked="True" Checked="OnActionTypeChecked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="ActionType" Tag="text" Content="Text"
                                     Checked="OnActionTypeChecked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="ActionType" Tag="sendKeys" Content="Keys"
                                     Checked="OnActionTypeChecked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="ActionType" Tag="macro" Content="Macro"
                                     Checked="OnActionTypeChecked"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="ActionType" Tag="media" Content="Media"
                                     Checked="OnActionTypeChecked"/>
                    </WrapPanel>

                    <StackPanel x:Name="RunPanel">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Program, file, folder, or URL"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Browse"
                                    Padding="12,7" Margin="8,0,0,0" Click="OnBrowse"/>
                            <TextBox x:Name="PathBox" Style="{StaticResource Field}" Tag="notepad.exe"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Arguments (optional)"/>
                        <TextBox x:Name="ArgsBox" Style="{StaticResource Field}" Tag="--new-window"/>
                    </StackPanel>

                    <StackPanel x:Name="TextPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Text to type"/>
                        <TextBox x:Name="ValueBox" Style="{StaticResource Field}" Tag="you@example.com"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <StackPanel x:Name="KeysPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Keys to send"/>
                        <local:KeyRecorder x:Name="KeysRecorder" IdleHint="Click to record the keys to send"/>
                    </StackPanel>

                    <StackPanel x:Name="MacroPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Steps"/>
                        <ItemsControl x:Name="StepList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Number}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="2">
                                            <local:KeyRecorder x:Name="StepKeys" Compact="True" Keys="{Binding Keys}"
                                                               IdleHint="Click to record" Visibility="Collapsed"/>
                                            <TextBox x:Name="StepText" Style="{StaticResource Field}" Tag="Text to type"
                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"
                                                     Visibility="Collapsed"/>
                                            <DockPanel x:Name="StepDelay" Visibility="Collapsed">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="ms"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <TextBox Style="{StaticResource Field}" Tag="100"
                                                         Text="{Binding Ms, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DockPanel>
                                            <TextBox x:Name="StepPath" Style="{StaticResource Field}" Tag="notepad.exe"
                                                     Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="Collapsed"/>
                                            <TextBlock x:Name="StepMedia" Text="{Binding CommandLabel}"
                                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                                        </Grid>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;"
                                                    ToolTip="Move up" Click="OnMoveStepUp"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;"
                                                    ToolTip="Move down" Click="OnMoveStepDown"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                                                    ToolTip="Remove" Click="OnRemoveStep"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="sendKeys">
                                            <Setter TargetName="StepKeys" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="text">
                                            <Setter TargetName="StepText" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="delay">
                                            <Setter TargetName="StepDelay" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="run">
                                            <Setter TargetName="StepPath" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Type}" Value="media">
                                            <Setter TargetName="StepMedia" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AddStepButton" Style="{StaticResource LinkButton}" Content="+ Add step"
                                HorizontalAlignment="Left" Click="OnAddStep">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Keys" Tag="sendKeys" Click="OnAddStepOfType"/>
                                    <MenuItem Header="Type text" Tag="text" Click="OnAddStepOfType"/>
                                    <MenuItem Header="Wait" Tag="delay" Click="OnAddStepOfType"/>
                                    <MenuItem Header="Run program" Tag="run" Click="OnAddStepOfType"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="MediaPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Command"/>
                        <WrapPanel x:Name="MediaChips">
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="playPause"
                                         Content="Play / pause" IsChecked="True"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="next" Content="Next"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="previous" Content="Previous"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="stop" Content="Stop"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="volumeUp" Content="Volume up"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="volumeDown"
                                         Content="Volume down"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="Media" Tag="mute" Content="Mute"/>
                        </WrapPanel>
                    </StackPanel>

                    <DockPanel Margin="0,18,0,0">
                        <ToggleButton x:Name="SuppressSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                      VerticalAlignment="Center" IsChecked="True"/>
                        <StackPanel>
                            <TextBlock Text="Block the keys from other apps"/>
                            <TextBlock Style="{StaticResource Muted}"
                                       Text="Turn off to let the app you're in see them too."/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
