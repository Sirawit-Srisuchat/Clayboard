<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Clayboard</RootNamespace>
    <AssemblyName>Clayboard</AssemblyName>
    <!-- The installer reads its version from the exe, so this is the one place to bump it. -->
    <Version>1.0.0</Version>
    <Product>Clayboard</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same icon for the tray and window, so they match the exe -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico"/>
    <!-- Bundled so every PC shows the same typefaces (all SIL Open Font License, see Assets/Fonts/*-OFL.txt) -->
    <Resource Include="Assets\Fonts\*.ttf"/>
  </ItemGroup>

</Project>
