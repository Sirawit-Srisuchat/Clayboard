<?xml version="1.0" encoding="utf-8"?>
<!-- One self-contained exe that runs without installing .NET: dotnet publish -p:PublishProfile=Portable -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- No compression: a compressed bundle is inflated into RAM on every start (about 145 MB more). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- Precompiled code, so startup doesn't wait on the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishDir>dist\MacroInWZa007\</PublishDir>
  </PropertyGroup>
</Project>
